# -----------------------------------------------------------------------------
# Git ignore do repositório Runner
# -----------------------------------------------------------------------------

# Saídas de build/teste - NUNCA commitar
/dist/
**/dist/
/target/
**/target/
/out/
**/out/
/bin/
**/bin/
*.class
*.test

# Cobertura e relatórios locais
coverage.out
**/coverage.out
coverage.html
**/coverage.html

# Artefatos empacotados localmente
*.AppImage
*.exe
*.dmg
*.jar
*.zip
*.tar.gz
*.sig
*.bundle
*.p12

# Saídas específicas do Runner na estrutura raiz
assinador/target/
assinador/out/
dist/
examples/*.json
examples/assinatura*.json
release/

# Estado local do Runner/HubSaúde
.hubsaude/
*.log
.cache/
tmp/
temp/

# IDE / sistema operacional
.idea/
.vscode/
.DS_Store
Thumbs.db
